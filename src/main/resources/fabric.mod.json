{
  "schemaVersion": 1,
  "id": "mousenavigation",
  "version": "${version}",
  "name": "[MR] Mouse Navigation",
  "description": "Enables mouse side buttons (Mouse 4 and Mouse 5) for intuitive back and forward navigation in screens, books, tabs, recipe books, and chat.",
  "authors": [
    "byMr712"
  ],
  "contact": {
    "homepage": "https://github.com/byMr712/MouseNavigation-MinecraftMod",
    "sources": "https://github.com/byMr712/MouseNavigation-MinecraftMod"
  },
  "license": "Apache-2.0",
  "icon": "assets/mousenavigation/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.mr712.mousenavigation.MouseNavigationClient"
    ],
    "modmenu": [
      "com.mr712.mousenavigation.integration.ModMenuIntegration"
    ]
  },
  "mixins": [
    "mousenavigation.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~1.21.4",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}